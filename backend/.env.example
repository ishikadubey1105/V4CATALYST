# SQLite file by default (zero setup). For PostgreSQL paste the URL your host gives you — postgres://,
# postgresql:// and postgresql+psycopg:// all work, e.g.
#   DATABASE_URL=postgresql://user:password@host:5432/baton
# Hosted databases often need SSL: append ?sslmode=require
DATABASE_URL=sqlite:///./baton.db
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Session lifetime in hours
SESSION_TTL_HOURS=12
# How often the deadline watcher scans for overdue tasks (seconds)
DEADLINE_INTERVAL_SECONDS=60
# Where uploaded documents are stored
UPLOAD_DIR=./uploads
# Load the demo accounts and cases into an empty database on startup.
# Set to false for real use, then create the first admin with: python manage.py create-admin ...
SEED_DEMO=true
# Organisation timezone for report periods and timestamps (servers run on UTC)
APP_TIMEZONE=Asia/Kolkata
# Also load ~21 months of past complaints so monthly/yearly reports have data (runs once; for demos)
SEED_HISTORY=false
# AI handoff assistant (Draft with AI / Brief me), on Groq. Get a key at https://console.groq.com/keys
# Without a key the assistant still works, using a template draft built from the case records.
GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-120b   # or llama-3.3-70b-versatile, openai/gpt-oss-20b ...
# AI_EFFORT=low                  # gpt-oss reasoning effort: low = fastest; medium/high = richer, slower
