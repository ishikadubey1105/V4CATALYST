# SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@localhost/baton
DATABASE_URL=sqlite:///./baton.db
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Session lifetime in hours
SESSION_TTL_HOURS=12
# How often the deadline watcher scans for overdue tasks (seconds)
DEADLINE_INTERVAL_SECONDS=60
# Where uploaded documents are stored
UPLOAD_DIR=./uploads
# Load the demo accounts and cases into an empty database on startup
SEED_DEMO=true
